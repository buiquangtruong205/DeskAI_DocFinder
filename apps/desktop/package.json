{
  "name": "deskai-desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite renderer",
    "dev:electron": "npm run build:electron && npx concurrently \"npm run dev\" \"npx wait-on tcp:5173 && npx electron .\"",
    "build:electron": "esbuild electron/src/main/index.ts --bundle --platform=node --external:electron --external:electron-squirrel-startup --external:better-sqlite3 --external:uuid --external:chokidar --outfile=dist/electron/main/index.js && esbuild electron/src/preload/index.ts --bundle --platform=node --external:electron --outfile=dist/electron/preload/index.js",
    "build": "vue-tsc --noEmit && vite build renderer && npm run build:electron",
    "preview": "vite preview renderer"
  },
  "main": "dist/electron/main/index.js",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "chokidar": "^3.6.0",
    "lucide-vue-next": "^0.344.0",
    "pinia": "^2.1.7",
    "uuid": "^9.0.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "esbuild": "^0.20.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6",
    "wait-on": "^7.2.0"
  }
}